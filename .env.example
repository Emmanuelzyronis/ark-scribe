# ArkScribe — Environment Variables
# Copy this to .env in each app directory and fill in values

# Database — Neon Postgres (ark-scribe database)
DATABASE_URL=postgresql://neondb_owner:PASSWORD@ep-nameless-dew-auyvuwsf-pooler.c-10.us-east-1.aws.neon.tech/arkscribe?sslmode=require&channel_binding=require
DATABASE_URL_DIRECT=postgresql://neondb_owner:PASSWORD@ep-nameless-dew-auyvuwsf.c-10.us-east-1.aws.neon.tech/arkscribe?sslmode=require

# Auth
JWT_SECRET=your-super-secret-jwt-key-min-32-chars
JWT_EXPIRY=7d

# Anthropic (Azure Foundry)
ANTHROPIC_API_KEY=your-anthropic-api-key
ANTHROPIC_BASE_URL=https://your-resource.cognitiveservices.azure.com/anthropic
CLAUDE_MODEL=claude-sonnet-4-6

# AssemblyAI
ASSEMBLYAI_API_KEY=your-assemblyai-api-key

# API
PORT=3001
NODE_ENV=development

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:3001
